{
    "name": "fusion-web-shell",
    "private": true,
    "workspaces": ["apps/*", "packages/*"],
    "scripts": {
        "typecheck": "bun run --filter '*' typecheck",
        "lint": "biome check --error-on-warnings .",
        "lint:fix": "biome check --write .",
        "test": "bun test",
        "build": "bun run --filter '*' build",
        "dev": "bun run --filter '@fusion/shell' dev"
    },
    "devDependencies": {
        "@biomejs/biome": "1.9.4",
        "@types/bun": "latest",
        "typescript": "^5.6.3"
    }
}
